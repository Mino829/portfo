{
  "name": "mino-portfolio-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run optimize:images && vite --host 127.0.0.1",
    "build": "npm run sync:notion && npm run optimize:images && vite build && npm run prerender",
    "preview": "vite preview --host 127.0.0.1",
    "sync:notion": "node --env-file-if-exists=.env scripts/sync-notion.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "prerender": "node scripts/prerender.mjs",
    "lint": "eslint .",
    "test": "node --test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.5",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "sharp": "^0.35.5"
  }
}
